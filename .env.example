# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno
# Copia este archivo a `.env` y reemplaza cada valor de ejemplo.
# `.env` está en `.gitignore`: nunca lo commitees.
# Ver docs de auditoría: openspec/changes/01-audit-exposed-secrets/
# ─────────────────────────────────────────────────────────────

# ── Servidor (NO públicas) ────────────────────────────────────
# Se leen únicamente en Node.js. Nunca las expongas al navegador.

# Requerida. Cadena de conexión a PostgreSQL.
# Genera una contraseña real en vez de usar "user:password".
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# Requerida. Secreto de firma de sesión de better-auth.
# Generar con: openssl rand -base64 32
# Sin valor, better-auth usa un fallback en desarrollo y falla en producción.
# Rotarla invalida todas las sesiones activas y los tokens de verificación
# pendientes, así que cámbiala en una ventana sin usuarios.
BETTER_AUTH_SECRET=""

# Requerida por better-auth. URL base de la app, sin barra final.
BETTER_AUTH_URL="http://localhost:3000"

# ── Correo transaccional (Mailtrap) ───────────────────────────
# Requerida SOLO para entregar los correos de autenticación (activación de
# cuenta, confirmación de cambio de correo y recuperación de contraseña).
# Token de API: Mailtrap → Account → API Tokens → Create.
# Hay dos streams con tokens distintos:
#   • Email Testing (sandbox): token con acceso al buzón de test. El envío va
#     a `sandbox.api.mailtrap.io` y cae en el buzón (ver
#     `MAILTRAP_TEST_INBOX_ID`). Ideal para desarrollo.
#   • Email Sending: token con acceso al dominio de envío verificado. El envío
#     va a `send.api.mailtrap.io`. Un token de Email Testing da 401 contra
#     este endpoint.
# Sin token, la entrega es un no-op silencioso: los flujos de auth completan
# igual y no se envía ningún correo.
MAILTRAP_API_TOKEN=""

# Remitente de los correos transaccionales.
# Para el stream Email Sending, el dominio de `MAILTRAP_FROM_EMAIL` debe estar
# verificado en Mailtrap (si no, Mailtrap rechaza con 401/domain-not-allowed).
# El sandbox de Email Testing acepta cualquier remitente, así que en desarrollo
# puede ser un valor inventado.
MAILTRAP_FROM_EMAIL="no-reply@example.com"
MAILTRAP_FROM_NAME="Nombre de la aplicación"

# Buzón de Email Testing (solo desarrollo). Si lo defines, el transporte entra
# en modo sandbox y el correo cae en ese buzón de test — el id se ve en
# Mailtrap → Email Testing → el buzón (número junto al nombre, p. ej. 4908530).
# Déjalo vacío cuando uses un token de Email Sending: la entrega irá entonces
# a `send.api.mailtrap.io`.
MAILTRAP_TEST_INBOX_ID=""

# Requerida si el proyecto usa el borrado de imágenes en Cloudinary.
# Panel de Cloudinary → Settings → API Keys.
# NUNCA les pongas el prefijo NEXT_PUBLIC_: se filtrarían al bundle del
# navegador. La operación que las usa es una server action.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Requerida solo por `pnpm seed`. Contraseña de las cuentas que crea el
# seeder. No se usa en runtime. Generar con: openssl rand -base64 18
SEED_USERS_PASSWORD=""

# Nivel de log documentado históricamente. `consoleLogger` NO lo lee: ese
# escribe únicamente cuando `NEXT_PUBLIC_ENVIRONMENT` vale "development"
# (sección Cliente, más abajo). Se conserva en la plantilla por coherencia con
# `.env` existentes; no gates ningún código de este repo.
# ⚠️ Nunca registres contraseñas ni tokens.
LOG_LEVEL="error"

# ── Cliente (públicas) ───────────────────────────────────────
# Llevan prefijo NEXT_PUBLIC_ porque Next.js las embebe en el bundle del
# navegador. Solo deben contener valores que sean públicos por diseño.
#
# ⚠️ No uses una variable NEXT_PUBLIC_ como guarda de seguridad de nada
# sensible: su valor se inlinea en tiempo de build y termina en el bundle del
# cliente. Para los guards del servidor usa una variable sin prefijo
# (p. ej. MAILTRAP_API_TOKEN).

# URL base de la app. Necesaria en el cliente: la usa auth-client.ts para
# las llamadas a better-auth.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gate de diagnóstico del `consoleLogger` del servidor (entrega de correo,
# server actions): sin el valor exacto "development", el logger no imprime
# nada. Lleva prefijo NEXT_PUBLIC_ porque `console-logger.ts` lo lee por ese
# nombre; no guarda nada sensible, es público por diseño.
NEXT_PUBLIC_ENVIRONMENT="development"

# Nombre del cloud de Cloudinary. Es público: forma parte de la URL del API.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Preset de subida. DEBE ser un preset "unsigned": es lo que permite subir
# desde el navegador sin credenciales. Un preset "signed" obligaría a
# publicar el API secret y haría inseguro el diseño actual.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Rol de superadministrador. Se usa para identificar a los usuarios con permisos
# de administración total.
SUPER_ADMIN_ROLE="admin"